NEXT_PUBLIC_API_URL=http://localhost:8080

# Equipments source: "local" (default, local CRUD) or "api" (read-only GET).
NEXT_PUBLIC_EQUIPMENT_SOURCE=local

# Loans source: "local" (default, local data) or "api" (read-only GET).
NEXT_PUBLIC_LOAN_SOURCE=local

# Collaborators source: "local" (default, local CRUD) or "api" (read-only GET).
NEXT_PUBLIC_COLLABORATOR_SOURCE=local
